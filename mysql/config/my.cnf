# MySQL 配置文件模板
# Author: DMP OPS
#
# 说明: MySQL 配置模板，安装时会根据系统内存自动调整参数
# 占位符: ${mysql_install_dir}, ${mysql_data_dir} 会在安装时替换

[client]
port = 3306
socket = /tmp/mysql.sock
default-character-set = utf8mb4

[mysql]
prompt="MySQL [\\d]> "
no-auto-rehash
default-character-set = utf8mb4

[mysqld]
# === 基础配置 ===
port = 3306
socket = /tmp/mysql.sock
basedir = ${mysql_install_dir}
datadir = ${mysql_data_dir}
pid-file = ${mysql_data_dir}/mysql.pid
user = mysql
bind-address = 0.0.0.0
# server-id: 单机保持 1；MGR 启用时全组唯一（由 mgr_server_id 或 IP 末段生成）
server-id = 1

# === 字符集配置 ===
init-connect = 'SET NAMES utf8mb4'
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# === 连接配置 ===
skip-name-resolve
back_log = 300
max_connections = 1000
max_connect_errors = 6000
open_files_limit = 65535
table_open_cache = 128
max_allowed_packet = 500M

# === 缓存配置 ===
binlog_cache_size = 1M
max_heap_table_size = 8M
tmp_table_size = 16M
read_buffer_size = 2M
read_rnd_buffer_size = 8M
sort_buffer_size = 8M
join_buffer_size = 8M
key_buffer_size = 4M
thread_cache_size = 8

# === 全文索引 ===
ft_min_word_len = 4

# === 二进制日志 ===
# MGR 启用时 binlog_format 必须为 ROW；单机保持 mixed
log_bin = mysql-bin
binlog_format = mixed
binlog_expire_logs_seconds = 604800
sync_binlog = 1

# === 错误日志 ===
log_error = ${mysql_data_dir}/mysql-error.log

# === 慢查询日志 ===
slow_query_log = 1
long_query_time = 1
slow_query_log_file = ${mysql_data_dir}/mysql-slow.log
log_queries_not_using_indexes = 0

# === 性能配置 ===
# MGR 启用时必须为 1（ON）；单机保持 0 以省内存
performance_schema = 0
explicit_defaults_for_timestamp = 1
skip-external-locking

# === InnoDB 配置 ===
default_storage_engine = InnoDB
innodb_file_per_table = 1
innodb_open_files = 500
innodb_buffer_pool_size = 64M
innodb_write_io_threads = 4
innodb_read_io_threads = 4
innodb_thread_concurrency = 0
innodb_purge_threads = 1
innodb_flush_log_at_trx_commit = 2
innodb_log_buffer_size = 2M
innodb_max_dirty_pages_pct = 90
innodb_lock_wait_timeout = 120
innodb_flush_method = O_DIRECT

# === MyISAM 配置 ===
bulk_insert_buffer_size = 8M
myisam_sort_buffer_size = 8M
myisam_max_sort_file_size = 10G

# === 超时配置 ===
interactive_timeout = 28800
wait_timeout = 28800

# === 复制配置（从库启用）===
# relay_log = relay-bin
# read_only = 1
# log_slave_updates = 1

# === MGR (Group Replication, single-primary) 启用时追加以下配置 ===
# 说明: MGR 单主模式 = 一写多读 + 主挂自动选新主，并非"双写双活"。
#       由 install.sh 根据 options.conf 的 mgr_enable=1 条件渲染，此处仅作文档参考。
# gtid_mode = ON
# enforce_gtid_consistency = ON
# log_slave_updates = 1
# relay_log = relay-bin
# relay_log_recovery = ON
# binlog_row_image = FULL
# plugin_dir = ${mysql_install_dir}/lib/plugin
# group_replication_group_name = <UUID>          # 全组一致，用 uuidgen 生成
# group_replication_local_address = <ip>:33061   # 本节点通信地址
# group_replication_group_seeds = <ip1>:33061,<ip2>:33061,...
# group_replication_bootstrap_group = OFF        # 引导时由 mgr_setup.sh 临时 SET GLOBAL
# group_replication_start_on_boot = OFF
# group_replication_single_primary_mode = ON
# group_replication_ssl_mode = DISABLED
# MySQL 8.0 专属（8.4 已废弃，不要写）:
# transaction_write_set_extraction = XXHASH64
# master_info_repository = TABLE
# relay_log_info_repository = TABLE

[mysqldump]
quick
max_allowed_packet = 500M
single-transaction

[myisamchk]
key_buffer_size = 8M
sort_buffer_size = 8M
read_buffer = 4M
write_buffer = 4M

[mysqlhotcopy]
interactive-timeout

# === 内存调优参考 ===
# 1GB 内存:
#   max_connections = 300
#   innodb_buffer_pool_size = 256M
#
# 2GB 内存:
#   max_connections = 500
#   innodb_buffer_pool_size = 512M
#
# 4GB 内存:
#   max_connections = 1000
#   innodb_buffer_pool_size = 1G
#
# 8GB+ 内存:
#   max_connections = 2000
#   innodb_buffer_pool_size = 4G
#   innodb_buffer_pool_instances = 4
