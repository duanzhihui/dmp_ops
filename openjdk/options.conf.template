# OpenJDK 中央配置文件
# 项目: dmp_ops/openjdk
# 所有可变参数集中在此，脚本内只引用变量

# ===== 配置版本号（勿手动修改，由 options.conf.template 同步）=====
conf_version=1

# ===== 镜像源 =====
mirror_link=https://mirrors.tuna.tsinghua.edu.cn
adoptium_deb_mirror=https://mirrors.tuna.tsinghua.edu.cn/Adoptium/deb
adoptium_rpm_mirror=https://mirrors.tuna.tsinghua.edu.cn/Adoptium/rpm
adoptium_file_mirror=https://mirrors.tuna.tsinghua.edu.cn/Adoptium
adoptium_api=https://api.adoptium.net/v3

# ===== 安装方式: package(包管理器) | binary(tar.gz 二进制) =====
install_method=package

# ===== 包管理器锁等待超时(秒) =====
# Ubuntu/Debian 开机后 unattended-upgrades 常持有 dpkg 锁，脚本会先等待再安装
pm_lock_timeout=600

# ===== 安装路径 =====
# binary 模式的安装根目录，实际目录为 ${jdk_base_dir}/jdk-{feature_ver}
jdk_base_dir=/usr/local
# 统一软链，JAVA_HOME 始终指向它，切换版本只需更换此软链
jdk_link=/usr/local/java

# ===== 版本 =====
jdk_support_vers="8 11 17 18 21"
# 当前默认版本，由 install.sh / switch.sh 自动写入，请勿手工修改
jdk_current_ver=
# 锁定补丁版本(binary 模式生效)，留空则自动获取最新 GA，如: 21.0.7+6
jdk_patch_ver=

# ===== 日志 =====
log_dir=/var/log/openjdk

# ===== 备份配置 =====
backup_dir=/data/backup/openjdk
expired_days=7
# 备份目标: local,remote,oss,cos,s3 (逗号分隔，可多选)
backup_destination=local
# 备份内容: cacerts,conf,jdk (逗号分隔，可多选)
backup_content=cacerts,conf
oss_bucket=
cos_bucket=
s3_bucket=
remote_host=
remote_port=22
remote_user=root
remote_dir=

# ===== JVM 监控阈值 =====
# 堆使用率告警阈值(%)
jvm_heap_threshold=85
# Full GC 累计次数告警阈值
jvm_fullgc_threshold=20
# 单进程线程数告警阈值
jvm_thread_threshold=2000
# 磁盘使用率告警阈值(%)
disk_threshold=85

# ===== 告警配置 =====
alert_email=
webhook_url=
