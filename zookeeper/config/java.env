# ZooKeeper JVM Configuration Template
# Generated by oneinstack/zookeeper

# JDK 路径
export JAVA_HOME=/usr/local/jdk

# 堆内存大小（MB）
# 建议：开发环境 512，生产环境 1024-4096
export ZK_SERVER_HEAP=1024

# GC 配置
# 推荐使用 G1GC（JDK 8+）
export SERVER_JVMFLAGS="-XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ParallelRefProcEnabled"

# 额外 JVM 参数
# export SERVER_JVMFLAGS="${SERVER_JVMFLAGS} -Djava.io.tmpdir=/tmp"

# JMX 配置（可选，用于监控）
# export JMXPORT=9999
# export JMXAUTH=false
# export JMXSSL=false
# export JMXLOG4J=false

# 远程调试（仅开发环境）
# export SERVER_JVMFLAGS="${SERVER_JVMFLAGS} -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5005"
