# ===== Chrony NTP Server 配置 =====
# 由 dmp_ops/chrony 自动生成，勿手工修改（重新执行 install.sh 会被覆盖）

# 上游时间源
{{UPSTREAM_SERVERS}}

# 对等 Server（双 Server 高可用时启用）
{{PEER_SERVERS}}

# 允许同步的内网网段
{{ALLOW_NETWORKS}}

# 外网不可达时以本机为孤岛时间基准，保证集群内部时间一致
local stratum {{LOCAL_STRATUM}}

# 系统时钟增益/损失速率记录文件
driftfile {{DRIFT_FILE}}

# 前 3 次校时若偏移大于 1 秒则直接跳变（而非缓慢 slew）
makestep 1.0 3

# 同步到 RTC 硬件时钟
rtcsync

# 命令端口监听地址（仅本机，安全）
bindcmdaddress 127.0.0.1
bindcmdaddress ::1

# 密钥文件
keyfile {{KEYS_FILE}}

# 日志
logdir /var/log/chrony
{{LOG_MEASUREMENTS}}
