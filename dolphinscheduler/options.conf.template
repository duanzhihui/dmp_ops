# Apache DolphinScheduler Deployment Configuration
# Project: DolphinSchedulerStack - Apache DolphinScheduler Cluster Deployment Tool
#
# Deployment modes:
#   standalone     - All services in one process (default, for testing)
#   pseudo-cluster - All services on single node, separate processes
#   cluster        - Multi-node deployment for production

#########################################################################
# 配置版本号（勿手动修改，由 options.conf.template 同步）
conf_version=1

#########################################################################
# Mirror link for downloading DolphinScheduler packages
# Package: apache-dolphinscheduler-<ver>-bin.tar.gz
mirror_link=https://downloads.apache.org/dolphinscheduler
archive_mirror_link=https://archive.apache.org/dist/dolphinscheduler

# set the default timezone
timezone=Asia/Shanghai

#########################################################################
# DolphinScheduler run user (Default "dolphinscheduler")
run_user=dolphinscheduler
run_group=dolphinscheduler

#########################################################################
# Installation directories
dolphinscheduler_home=/opt/dolphinscheduler
dolphinscheduler_install_dir=/opt/dolphinscheduler

# Data directories
dolphinscheduler_data_dir=/data/dolphinscheduler

# Log directories
dolphinscheduler_log_dir=/data/dolphinscheduler/logs

#########################################################################
# Port Configuration
# Web UI port (standalone-server)
web_port=12345

# API Server port
api_port=25333

# Master Server ports
# RPC port for internal communication
master_rpc_port=5678
# Web port for actuator/metrics (must be different from RPC port)
master_web_port=5679

# Worker Server ports
# RPC port for internal communication
worker_rpc_port=1234
# Web port for actuator/metrics (must be different from RPC port)
worker_web_port=1235

# Alert Server ports
# RPC port for internal communication
alert_rpc_port=50052
# Web port for actuator/metrics (must be different from RPC port)
alert_web_port=50053

#########################################################################
# Deployment mode: standalone, pseudo-cluster, cluster
deploy_mode=standalone

#########################################################################
# Database Configuration
# Database type: mysql, postgresql
db_type=mysql

# Database connection
db_host=localhost
db_port=3306
db_name=dolphinscheduler
db_user=root
db_password=

# MySQL JDBC Driver version (8.0.16+ required)
mysql_jdbc_ver=8.0.33

#########################################################################
# ZooKeeper Configuration (required for pseudo-cluster and cluster mode)
zk_hosts=localhost:2181

#########################################################################
# Cluster Configuration (for pseudo-cluster and cluster mode)
#
# In cluster mode every node listed in 'ips' must appear in at least one of
# masters / workers / api_servers / alert_server. Each node only gets the
# systemd services for the roles assigned to it.

# All node IPs (comma separated)
# e.g. ips="192.168.1.1,192.168.1.2,192.168.1.3"
ips=localhost

# SSH settings for remote deployment (cluster mode)
# Passwordless SSH from this node to all cluster nodes is expected.
# ssh_user must be able to create users and write to /opt and /lib/systemd
# (root, or a user with passwordless sudo). The deploy user (run_user) is created
# by this script on each node, so it cannot be used to bootstrap a fresh node.
ssh_port=22
ssh_user=root
# SSH key file path (empty means the default key of ssh_user)
ssh_key_file=

# Master nodes (comma separated)
# e.g. masters="192.168.1.1,192.168.1.2"
masters=localhost

# Worker nodes (comma separated, format: ip:group)
# e.g. workers="192.168.1.3:default,192.168.1.4:default"
workers=localhost:default

# Alert Server node
alert_server=localhost

# API Server nodes (comma separated)
# e.g. api_servers="192.168.1.1,192.168.1.2"
api_servers=localhost

#########################################################################
# Resource Storage Configuration
# Storage type: NONE, HDFS, S3, OSS, GCS, ABS, LOCAL
resource_storage_type=LOCAL

# Local storage path (when resource_storage_type=LOCAL)
resource_local_path=/data/dolphinscheduler/resource

# HDFS configuration (when resource_storage_type=HDFS)
hdfs_defaultfs=
hdfs_root_path=/dolphinscheduler

# S3 configuration (when resource_storage_type=S3)
s3_endpoint=
s3_access_key=
s3_secret_key=
s3_region=
s3_bucket=

#########################################################################
# JAVA_HOME path (auto-detect if empty)
JAVA_HOME=

#########################################################################
# Backup Configuration
backup_dir=/data/backup/dolphinscheduler
expired_days=7
backup_destination=local
backup_content=db,config,logs

#########################################################################
# Alert Configuration (optional)
alert_email=
webhook_url=
