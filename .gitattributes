# ============================================================
# .gitattributes - 统一团队换行符与文件处理方式
# 目标：所有文本文件在仓库中统一使用 LF（Linux 换行符）
# ============================================================

# 默认：自动识别文本文件，提交时使用 LF
* text=auto eol=lf

# ------------------------------------------------------------
# 代码与脚本文件（强制 LF）
# ------------------------------------------------------------
*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.jsx       text eol=lf
*.tsx       text eol=lf
*.vue       text eol=lf
*.java      text eol=lf
*.go        text eol=lf
*.rs        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
*.cs        text eol=lf
*.php       text eol=lf
*.rb        text eol=lf
*.sql       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.less      text eol=lf

# ------------------------------------------------------------
# 配置与文档文件（强制 LF）
# ------------------------------------------------------------
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.conf      text eol=lf
*.env       text eol=lf
*.csv       text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf

# ------------------------------------------------------------
# Windows 专用脚本（保留 CRLF，否则可能无法正常运行）
# ------------------------------------------------------------
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ------------------------------------------------------------
# 二进制文件（禁止任何换行符转换）
# ------------------------------------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svg       binary
*.pdf       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.7z        binary
*.exe       binary
*.dll       binary
*.so        binary
*.jar       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.mp3       binary
*.mp4       binary
*.xlsx      binary
*.docx      binary
*.pptx      binary
